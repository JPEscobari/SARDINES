
# IBM watsonx Orchestrate
IBM_API_KEY=REPLACE_WITH_AUTHORIZED_KEY
WATSONX_INSTANCE_URL=REPLACE_WITH_INSTANCE_URL
WATSONX_AGENT_ID=REPLACE_WITH_AGENT_ID
WATSONX_STUB=false

# IBM Cloudant
OPERATIONAL_STORE=cloudant
CLOUDANT_URL=REPLACE_WITH_CLOUDANT_URL
CLOUDANT_API_KEY=REPLACE_WITH_AUTHORIZED_KEY
CLOUDANT_DATABASE=sardines-dev

# IBM Speech to Text
STT_URL=REPLACE_WITH_STT_SERVICE_URL
STT_API_KEY=REPLACE_WITH_AUTHORIZED_KEY
STT_MODEL=en-US_Multimedia
STT_MAX_UPLOAD_BYTES=8388608
STT_MAX_DURATION_SECONDS=120

# Slack
SLACK_APP_TOKEN=REPLACE_WITH_APP_TOKEN
SLACK_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
SLACK_USER_TOKEN=REPLACE_WITH_USER_TOKEN_IF_REQUIRED
SARDINES_SLACK_TEAM_ID=REPLACE_WITH_TEAM_ID
SARDINES_SLACK_SAVE_USERS=REPLACE_WITH_ALLOWLISTED_USER_IDS
SARDINES_SLACK_RECIPIENTS=[]
SARDINES_SLACK_SEND_ENABLED=false

# Development
PORT=5000
FFMPEG_PATH=REPLACE_WITH_LOCAL_ABSOLUTE_PATH
FFPROBE_PATH=REPLACE_WITH_LOCAL_ABSOLUTE_PATH
