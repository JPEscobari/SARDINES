# SARDINES local development configuration. No access is granted by this file.
# Copy ONLY when .env does not already exist. Never overwrite a teammate's .env.
# Root .env: Express and Node Slack processes. See docs/environment-variables.md.
# Frontend/test terminal settings below are inventory entries; export them as documented.
# Secrets remain empty. Sending, recovery and live-test gates remain disabled.


# --- Local runtime ---
# Optional | Express, Slack
# Local mode; production disables review/media/demo operations, not all routes.
# Set locally; not authentication.
NODE_ENV=development
# Optional | Express
# Loopback backend port.
# Set locally; frontend proxy must match.
PORT=5000
# Optional; cloudant to opt in | Express, Slack, repository scripts
# sqlite (default) or cloudant; no automatic migration/fallback.
# Use sqlite until shared-database access is granted.
OPERATIONAL_STORE=sqlite
# Optional | SQLite repository
# Database path; blank uses server/data/operational.sqlite resolved from the repository.
# Prefer an absolute path under ignored server/data; relative overrides follow process cwd.
SARDINES_DB_PATH=
# Optional, legacy only | Express / Mongoose
# Mongo connection for original Chat, Tasks and Decisions; not operational storage.
# Ask the legacy database owner; example mongodb://127.0.0.1:27017/sardines_legacy.
MONGO_URI=

# --- Orchestrate ---
# Required for extraction | Express; Slack Save to SARDINES; live IBM scripts
# IAM API key used by server/services/watsonx.service.js.
# Authorized IBM account/service owner; not an alias of IBM_API_KEY.
WATSONX_API_KEY=
# Required for extraction | Orchestrate adapter
# Instance base URL; adapter appends /v1/orchestrate/{agentId}/chat/completions.
# Copy the existing Orchestrate instance API endpoint; omit trailing slash and appended completion path.
WATSONX_INSTANCE_URL=
# Required for extraction | Orchestrate adapter
# Existing deployed agent identifier.
# Obtain from authorized agent owner; do not redeploy an agent for setup.
WATSONX_AGENT_ID=
# Optional; must not be true for extraction | Legacy chat / extraction
# true only stubs legacy chat; structured ingestion explicitly rejects stub mode.
# Keep false. Offline browser fixtures mock APIs separately.
WATSONX_STUB=false

# --- Slack Granite summarizer ---
# Required for Slack summary | Slack watsonx.ai adapter; legacy Python
# IAM key for watsonx.ai / Granite; NOT read by the Orchestrate adapter.
# Authorized IBM account/project owner.
IBM_API_KEY=
# Required for Slack summary | Slack watsonx.ai adapter; legacy Python
# watsonx.ai regional origin; adapter appends /ml/v1/text/chat.
# Existing project regional endpoint, e.g. https://us-south.ml.cloud.ibm.com; no trailing slash.
WATSONX_URL=
# Required for Slack summary | Slack watsonx.ai adapter; legacy Python
# Project owning model access.
# Authorized watsonx.ai project settings/owner.
WATSONX_PROJECT_ID=
# Required for Slack summary | Slack watsonx.ai adapter; legacy Python
# Model identifier; example used by repository tests, not an availability guarantee.
# Confirm supported model with the project owner; no model default in source.
WATSONX_MODEL_ID=ibm/granite-4-h-small

# --- Cloudant ---
# Required only for cloudant backend | Cloudant client
# HTTPS service origin, without database/path/query or embedded credentials.
# Existing Cloudant service credentials; example https://<service-host>.cloudantnosqldb.appdomain.cloud.
CLOUDANT_URL=
# Required only for cloudant backend | Cloudant client
# IAM API key with access to the chosen database.
# Authorized Cloudant service/account owner.
CLOUDANT_API_KEY=
# Required only for cloudant backend | Cloudant client
# Existing non-partitioned application database; never automatically created.
# Database owner grants access and supplies name; shared sardines-dev must not be reset.
CLOUDANT_DATABASE=

# --- Speech to Text ---
# Required for transcription | IBM STT adapter
# Exact HTTPS regional instance URL; no labels, query, port or credentials.
# Existing STT Manage/API details: https://api.<region>.speech-to-text.watson.cloud.ibm.com/instances/<instance-id>.
STT_URL=
# Required for transcription | IBM STT adapter
# IAM API key for that STT instance.
# Existing service credentials from authorized STT owner.
STT_API_KEY=
# Optional | IBM STT adapter
# Default en-US_Multimedia; also permits en-GB_Multimedia/en-AU_Multimedia if instance supports them.
# Verify model availability on the configured instance.
STT_MODEL=en-US_Multimedia
# Optional | WAV route, STT and video adapter
# 8 MiB default, positive integer <=16777216; browser WAV cap remains 8 MiB.
# Local limit, not a credential.
STT_MAX_UPLOAD_BYTES=8388608
# Optional | WAV/STT and video adapter
# 120 default, positive integer <=300; video remains capped at min(120, this setting).
# Local limit; one-hour recordings unsupported.
STT_MAX_DURATION_SECONDS=120

# --- Video ---
# Optional with PATH; otherwise required for video | Video extraction
# Absolute ffmpeg.exe (Windows) / ffmpeg executable; blank searches absolute PATH directories, excluding cwd.
# Trusted local install; e.g. C:/Tools/ffmpeg/bin/ffmpeg.exe; no arguments or extra embedded quotes.
FFMPEG_PATH=
# Optional with PATH; otherwise required for video | Video validation
# Absolute ffprobe.exe (Windows) / ffprobe executable; invalid explicit path does not fall back.
# Trusted local install; e.g. C:/Tools/ffmpeg/bin/ffprobe.exe.
FFPROBE_PATH=
# Optional | Video route/service
# 32 MiB default, positive integer <=67108864; browser cap remains 32 MiB.
# No separate VIDEO_MAX_DURATION_SECONDS is implemented.
VIDEO_MAX_UPLOAD_BYTES=33554432

# --- Slack ---
# Required for Bolt | Slack Socket Mode
# App-level token with connections:write.
# Authorized Slack app owner, Basic Information / app-level tokens.
SLACK_APP_TOKEN=
# Required for Bolt and follow-up tools | Slack Bolt / CLI
# Bot OAuth token; scopes described in integration setup.
# Authorized app installation, OAuth & Permissions.
SLACK_BOT_TOKEN=
# Required for current summary reader | Slack thread reader; legacy Python
# User OAuth token for conversations.replies; bot token is not a fallback in this code.
# Approved Slack installation/user with access to intended conversations.
SLACK_USER_TOKEN=
# Required for save/follow-up/replies | Slack integration
# Exact allowed workspace ID; blank denies Save and reply processing.
# Approved workspace administrator; synthetic format TTEST.
SARDINES_SLACK_TEAM_ID=
# Required for Slack Save | Slack Save bridge
# Comma-separated approved Slack user IDs; blank denies saving, not ordinary summaries.
# Approved development user IDs; synthetic format UTEST,UOTHER.
SARDINES_SLACK_SAVE_USERS=
# Required for previews/follow-up/replies | Express and Slack integration
# JSON array with exactly label, ownerId, teamId, userId; maximum 30 and unique ownerIds.
# Approved directory, not AI output. Example in integration setup.
SARDINES_SLACK_RECIPIENTS=[]
# Optional; exact true only for authorized demo | Follow-up CLI
# Default-disabled gate; also needs interactive CLI, version/hash and verified recipient.
# Does NOT disable normal summarizer response messages or reply storage.
SARDINES_SLACK_SEND_ENABLED=false
# Optional; exact true only for authorized recovery | Recovery CLI
# Gate for confirmed reconciliation/reply replay writes, not inspection.
# Keep false during onboarding.
SARDINES_SLACK_RECOVERY_ENABLED=false

# --- Frontend process settings ---
# Optional; set in Vite terminal | client/vite.config.js
# Development /api proxy target; source fallback is http://localhost:5000.
# Root .env entry alone is NOT loaded into Vite config; export in launching terminal.
API_PROXY_TARGET=http://127.0.0.1:5000
# Optional; browser-visible | React API client
# Blank defaults to /api, recommended with same-origin dev proxy.
# Set in client/.env or Vite terminal, not root .env alone; never include credentials.
VITE_API_BASE=

# --- Inactive browser embed ---
# Optional, unused by current Dashboard | Preserved OrchestrateChat.jsx
# Public embed orchestration identifier; component is not mounted.
# Authorized embed settings only; omit for normal setup.
VITE_WATSONX_ORCHESTRATION_ID=
# Optional, unused by current Dashboard | Preserved OrchestrateChat.jsx
# Public embed agent identifier, distinct variable from server WATSONX_AGENT_ID.
# Authorized embed settings; source hardcodes eu-gb host.
VITE_WATSONX_AGENT_ID=
# Optional, unused by current Dashboard | Preserved OrchestrateChat.jsx
# Browser-visible resource identifier, not a secret or server credential.
# Authorized embed settings; do not populate unless intentionally using the embed.
VITE_WATSONX_CRN=

# --- Opt-in tests ---
# Optional; launching terminal | test-ingest-live.js
# Origin of running backend; script default is http://localhost:5001.
# Script does NOT load root .env; set in terminal explicitly.
TEST_API_BASE=http://127.0.0.1:5000
# Required true to run live Cloudant test | test-cloudant-live.js
# Read-only unless both --write and write gate supplied; forces Cloudant even if normal store is SQLite.
# Explicit authorized test only.
CLOUDANT_LIVE_TEST=false
# Required development plus --write to mutate | test-cloudant-live.js
# Creates/retains a synthetic source and edits its Promise; not a database-name safety check.
# Use only after owner authorizes a designated development database.
CLOUDANT_TEST_ALLOW_WRITE=
# Required true for live STT script | test-stt-live.js
# Requires approved 30-60 second PCM WAV; model lookup and real recognition; no persistence.
# Explicit authorized IBM usage only.
STT_LIVE_TEST=false
# Required true for live video script | test-video-live.js
# Real extraction and STT for one short synthetic MP4.
# Explicit authorized IBM usage only.
VIDEO_LIVE_TEST=false
# Optional true adds live extraction and write | test-video-live.js
# Also calls Orchestrate and saves a new source; requires cloudant, sardines-dev and non-stub Orchestrate.
# Separate explicit shared-database write authorization; keep false for transcription-only test.
VIDEO_LIVE_SAVE=false
